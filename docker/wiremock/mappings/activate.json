{
  "mappings": [
    {
      "name": "sucesso (padrão)",
      "priority": 10,
      "request": { "method": "POST", "urlPath": "/provider/v1/activate" },
      "response": {
        "status": 200,
        "headers": { "Content-Type": "application/json" },
        "body": "{\"activationId\":\"{{randomValue type='UUID'}}\",\"requestId\":\"{{jsonPath request.body '$.requestId'}}\"}"
      }
    },
    {
      "name": "productCode REJECT-* => 400",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/provider/v1/activate",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.productCode =~ /REJECT.*/)]" }]
      },
      "response": { "status": 400, "jsonBody": { "error": "PRODUCT_NOT_AVAILABLE" } }
    },
    {
      "name": "productCode UNAVAILABLE-* => 503 com Retry-After",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/provider/v1/activate",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.productCode =~ /UNAVAILABLE.*/)]" }]
      },
      "response": { "status": 503, "headers": { "Retry-After": "5" } }
    },
    {
      "name": "productCode ERROR-* => 500",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/provider/v1/activate",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.productCode =~ /ERROR.*/)]" }]
      },
      "response": { "status": 500 }
    },
    {
      "name": "productCode SLOW-* => responde depois do read-timeout",
      "priority": 1,
      "request": {
        "method": "POST",
        "urlPath": "/provider/v1/activate",
        "bodyPatterns": [{ "matchesJsonPath": "$[?(@.productCode =~ /SLOW.*/)]" }]
      },
      "response": { "status": 200, "fixedDelayMilliseconds": 8000 }
    }
  ]
}
